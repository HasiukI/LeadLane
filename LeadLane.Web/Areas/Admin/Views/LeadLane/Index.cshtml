@{
    ViewData["Title"] = "Board";
}

<section class="admin-board">
    <header class="admin-board__top">
        <h1 class="admin-board__title">Board</h1>
        <p class="admin-board__subtitle">Leads by status</p>
    </header>

    <aside class="admin-board__attention" aria-label="Needs attention">
        <h2 class="admin-board__attention-title">Needs attention</h2>
        <p class="admin-board__empty">No leads yet.</p>
    </aside>

    <div class="admin-board__kanban" aria-label="Kanban">
        <section class="kanban-column">
            <h2 class="kanban-column__title">New</h2>
            <div class="kanban-column__list"></div>
        </section>
        <section class="kanban-column">
            <h2 class="kanban-column__title">In progress</h2>
            <div class="kanban-column__list"></div>
        </section>
        <section class="kanban-column">
            <h2 class="kanban-column__title">Agreed</h2>
            <div class="kanban-column__list"></div>
        </section>
        <section class="kanban-column">
            <h2 class="kanban-column__title">Won</h2>
            <div class="kanban-column__list"></div>
        </section>
        <section class="kanban-column">
            <h2 class="kanban-column__title">Lost</h2>
            <div class="kanban-column__list"></div>
        </section>
    </div>
</section>
