@model CreateLeadViewModel
@{
    ViewData["Title"] = "Request a callback";
}

<section class="public-lead">
    <h1 class="public-lead__brand">LeadLane</h1>
    <p class="public-lead__lead">Leave a callback request — we will get back to you.</p>

    @if (TempData["Success"] is string success)
    {
        <p class="public-lead__success">@success</p>
    }

    <form class="public-lead__form" asp-controller="Home" asp-action="Index" method="post">
        <div asp-validation-summary="ModelOnly" class="public-lead__errors"></div>

        <div class="public-lead__field">
            <label asp-for="Name"></label>
            <input asp-for="Name" autocomplete="name" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="public-lead__field">
            <label asp-for="Phone"></label>
            <input asp-for="Phone" autocomplete="tel" />
            <span asp-validation-for="Phone"></span>
        </div>

        <div class="public-lead__field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="public-lead__field">
            <label asp-for="Message"></label>
            <textarea asp-for="Message" rows="4"></textarea>
            <span asp-validation-for="Message"></span>
        </div>

        <button class="public-lead__submit" type="submit">Send request</button>
    </form>
</section>
