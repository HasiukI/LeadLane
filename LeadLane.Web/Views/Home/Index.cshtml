@model CreateLeadViewModel
@{
    ViewData["Title"] = "Callback request";
}

<section class="public-home">
    <div class="public-home__intro">
        <h1 class="public-home__brand">LeadLane</h1>
        <p class="public-home__tagline">
            A small CRM for inbound leads — from website form to kanban, notes, and the next call.
        </p>
        <p class="public-home__body">
            Built for owners and managers who get “please call back” messages and still track them
            in chat apps or spreadsheets. Visitors leave a request here; the team works them on a
            status board: New → In progress → Agreed → Won or Lost.
        </p>
        <p class="public-home__hint">
            Demo admin:
            <a asp-area="Auth" asp-controller="Auth" asp-action="Login">sign in</a>
            with <code>admin</code> / <code>admin123</code>.
        </p>
    </div>

    <div class="public-home__form-panel">
        <h2 class="public-home__form-title">Request a callback</h2>
        <p class="public-home__form-lead">Leave your details — we will get back to you.</p>

        @if (TempData["Success"] is string success)
        {
            <p class="public-home__success">@success</p>
        }

        <form class="public-home__form" asp-controller="Home" asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="public-home__errors"></div>

            <div class="public-home__field">
                <label asp-for="Name"></label>
                <input asp-for="Name" autocomplete="name" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="public-home__field">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" autocomplete="tel" />
                <span asp-validation-for="Phone"></span>
            </div>

            <div class="public-home__field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="public-home__field">
                <label asp-for="Message"></label>
                <textarea asp-for="Message" rows="4"></textarea>
                <span asp-validation-for="Message"></span>
            </div>

            <button class="public-home__submit" type="submit">Send request</button>
        </form>
    </div>
</section>
